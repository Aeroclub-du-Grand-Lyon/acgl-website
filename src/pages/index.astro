---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import heroImage from "../assets/hero.jpg";
import ButtonLink from "../components/ButtonLink.astro";
import Card from "../components/Card.astro";
import Carousel from "../components/Carousel.astro";
import Icon from "../components/Icon.astro";
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/Section.astro";
import { toTelHref } from "../lib/phone";

const pathCardLinkClass =
  "group flex h-full flex-col no-underline rounded-2xl border bg-slate-700/80 p-6 transition-colors duration-[250ms] hover:bg-gray-500/40 [box-shadow:inset_0_1px_0_rgba(255,255,255,0.35),0_8px_32px_rgba(0,0,0,0.25)] lg:hover:bg-gray-500/50";
const homeNumbersEntries = await getCollection("homeClubNumbers");
const heroStats = homeNumbersEntries[0]?.data.stats ?? [];

const contactEntries = await getCollection("contactSettings");
const contact = contactEntries[0]?.data;

const fleet = await getCollection("fleet");
const fleetCount = fleet.length;

const instructors = await getCollection("instructors");
const instructorCount = instructors.length;

const galleryEntries = await getCollection("clubGallery");
const galleryImages = galleryEntries[0]?.data.images ?? [];

const phoneHref = contact?.phone ? `tel:${toTelHref(contact.phone)}` : undefined;
const addressLine = contact?.address
  ? `${contact.address.street}, ${contact.address.postalCode} ${contact.address.city}`
  : undefined;

const visitItems: { icon: string; label: string; value: string; href?: string }[] = [
  addressLine && { icon: "map-pin", label: "Adresse", value: addressLine },
  contact?.permanence && {
    icon: "clock",
    label: "Permanence club",
    value: contact.permanence.charAt(0).toUpperCase() + contact.permanence.slice(1),
  },
].filter(Boolean) as { icon: string; label: string; value: string; href?: string }[];

const pathCards: { href: string; icon: string; label: string; title: string; desc: string; cta: string }[] = [
  {
    href: "/vol-decouverte",
    icon: "compass",
    label: "Découvrir",
    title: "Vols découverte",
    desc: "S'initier au plaisir de voler accompagné d'un de nos instructeurs.",
    cta: "Offrir ou s'offrir un vol",
  },
  {
    href: "/ecole-de-pilotage",
    icon: "book-open",
    label: "Apprendre",
    title: "École de pilotage",
    desc: `Formation PPL(A) ou LAPL(A) avec nos instructeurs, du premier vol à la licence.`,
    cta: "Devenir pilote",
  },
  {
    href: "/deja-pilote",
    icon: "plane",
    label: "Voler",
    title: "Déjà pilote",
    desc: "Rejoignez notre communauté de pilotes et volez sur notre flotte diversifiée.",
    cta: "Rejoindre le club",
  },
  {
    href: "/progresser",
    icon: "trending-up",
    label: "Progresser",
    title: "Perfectionnements",
    desc: "Vol de nuit, train rentrant, IFR : enrichissez votre licence avec des qualifications avancées.",
    cta: "Se perfectionner",
  },
];
---

<MainLayout
  title="Aéroclub du Grand Lyon | Apprendre à piloter et voler à Lyon Bron"
  description={`Aéroclub à Lyon Bron : baptême de l'air, cours de pilotage et location d'avion. Une flotte de ${fleetCount} avions, des instructeurs passionnés et une vraie ambiance club — ACGL, agréé DGAC.`}
>
  <section
    class="relative isolate flex min-h-[82svh] flex-col overflow-hidden pt-25 pb-6 lg:min-h-[80vh] lg:overflow-hidden lg:pb-10"
    aria-labelledby="hero-heading"
  >
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <Image
        src={heroImage}
        alt=""
        class="h-full w-full object-cover object-center"
        width={1920}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        quality={80}
      />
    </div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-navy/50 via-navy/10 to-navy/50 lg:hidden" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-navy/50 via-navy/25 to-navy/65 lg:hidden" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-b from-navy/80 via-navy/40 to-navy/25 lg:block" aria-hidden="true" />

    <div class="container relative z-[1] flex flex-1 flex-col items-center justify-center gap-8 py-6 text-center lg:hidden">
      <Image
        src="/logo-vertical.svg"
        alt=""
        width="240"
        height="240"
        class="w-[clamp(140px,50vw,240px)] h-auto drop-shadow-md"
        loading="eager"
      />

      <div class="flex w-full max-w-md flex-col items-center gap-6">
        <div class="w-full text-left md:text-center">
          <h1
            id="hero-heading"
            class="mb-3 font-display text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold tracking-tight text-white md:mb-4"
          >
            Voler, <span class="text-sky">c'est ici</span> que ça commence !
          </h1>
          <p class="text-sm leading-relaxed text-white/80 md:text-base">
            Apprenez à piloter ou volez avec votre licence depuis Lyon Bron.
          </p>
        </div>

        <ButtonLink href="#paths" variant="primary" aria-label="Aller aux parcours">
          Découvrir mon parcours
        </ButtonLink>
      </div>
    </div>

    <div class="container relative z-[1] hidden flex-col flex-1 lg:flex lg:justify-center lg:gap-15">
      <div class="flex flex-col items-center justify-center text-center lg:flex-row lg:items-center lg:text-left lg:gap-10">
        <Image
          src="/logo-square.svg"
          alt=""
          width="96"
          height="96"
          class="mb-6 size-28 shrink-0 drop-shadow-md lg:mb-0"
          loading="eager"
        />
        <div>
          <h1 class="mb-4 font-display text-[clamp(1.75rem,4.5vw,2.75rem)] font-semibold tracking-tight text-white md:mb-5">
            Voler, c'est ici que ça commence !
          </h1>
          <p class="text-sm leading-relaxed text-white/80 md:text-base">
            Apprenez à piloter ou volez avec votre licence depuis Lyon Bron. Découvrez votre parcours.
          </p>
        </div>
      </div>

      <div>
        <h2 id="path-cards-heading" class="sr-only">Votre projet à l'ACGL</h2>
        <div class="grid gap-4 lg:grid-cols-4">
          {pathCards.map(({ href, icon, label, desc, cta }) => (
            <a href={href} class={pathCardLinkClass}>
              <div class="mb-4 flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition-[transform,background-color,color] duration-[250ms] group-hover:scale-110 group-hover:bg-brand group-hover:text-white" aria-hidden="true">
                  <Icon name={icon} size="size-5" />
                </div>
                <h3 class="text-base font-bold uppercase tracking-label text-white/90">{label}</h3>
              </div>
              <p class="mb-4 flex-1 text-sm leading-relaxed text-white/80">{desc}</p>
              <span class="mt-auto flex items-center gap-1.5 text-sm font-semibold text-white/80 transition-colors duration-[250ms] group-hover:text-white">
                {cta}
                <Icon name="arrow-right" size="size-4" class="transition-transform duration-[250ms] group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </div>

      {heroStats.length > 0 && (
        <div
          class="mx-auto mt-8 flex w-fit flex-wrap items-center justify-center gap-x-7 gap-y-3 border-t border-white/20 pt-7"
          role="group"
          aria-label="Chiffres clés du club"
        >
          <ul class="flex list-none flex-wrap justify-center gap-8 p-0">
            {heroStats.map((item) => (
              <li class="flex flex-col items-center gap-0.5">
                <span class="font-display text-xl font-semibold tabular-nums leading-none text-white">{item.value}</span>
                <span class="text-xs font-medium uppercase tracking-label text-white/70">{item.label}</span>
              </li>
            ))}
          </ul>
          <span class="hidden h-5 w-px bg-white/20 sm:block" aria-hidden="true"></span>
          <span class="hidden items-center gap-1.5 text-sm text-white/70 sm:flex">
            <Icon name="users" size="size-3.5" class="shrink-0 text-sky" />
            Affilié à la Fédération Française Aéronautique
          </span>
        </div>
      )}
    </div>
  </section>

  <section
    id="paths"
    aria-labelledby="paths-heading"
    class="relative z-10 -mt-10 scroll-mt-header-h rounded-t-3xl border-b border-line bg-page lg:hidden"
  >
    <div class="container">
      <header class="mx-auto pt-10 mb-10 text-center">
        <h2 id="paths-heading">Quel est votre projet ?</h2>
        <p class="mt-3 text-muted">Que vous rêviez d'apprendre à voler ou que vous ayez déjà votre licence nous pouvons vous accompagner.</p>
      </header>
      <div class="grid gap-4 sm:grid-cols-2">
        {pathCards.map(({ href, icon, label, desc, cta }) => (
          <Card as="a" href={href} variant="surfaceLink" class="h-full bg-page">
            <div class="mb-4 flex items-center gap-3">
              <div class="card-surface-icon" aria-hidden="true">
                <Icon name={icon} size="size-5" />
              </div>
              <h3 class="text-base font-bold uppercase tracking-label text-brand">{label}</h3>
            </div>
            <p class="mb-4 flex-1 text-sm leading-relaxed text-muted">{desc}</p>
            <span class="card-surface-cta">
              {cta}
              <Icon name="arrow-right" size="size-4" class="card-surface-cta-arrow" />
            </span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <Section bg="surface" class="py-12">
    <header class="mx-auto mb-8 text-center">
      <h2>Pourquoi choisir l'ACGL ?</h2>
      <p class="mt-3 text-muted">Un club ouvert à tous, que vous soyez novice ou un pilote confirmé.</p>
    </header>
    <ul class="grid gap-6 sm:grid-cols-2">
      <Card as="li" size="lg" class="bg-page">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex size-10 items-center justify-center rounded-lg bg-light-frost text-brand" aria-hidden="true">
            <Icon name="plane" size="size-6" />
          </div>
          <h3>Flotte diversifiée</h3>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Une flotte de {fleetCount} avions permettant de répondre à toutes vos envies. Formation, balade, voyage ou encore vol aux instruments.
        </p>
      </Card>
      <Card as="li" size="lg" class="bg-page">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex size-10 items-center justify-center rounded-lg bg-light-frost text-brand" aria-hidden="true">
            <Icon name="graduation" size="size-6" />
          </div>
          <h3>Instructeurs qualifiés</h3>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          {instructorCount} instructeurs disponibles en semaine ou le week-end pour vous accompagner que vous soyez élèves ou déjà pilote.
        </p>
      </Card>
      <Card as="li" size="lg" class="bg-page">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex size-10 items-center justify-center rounded-lg bg-light-frost text-brand" aria-hidden="true">
            <Icon name="euro" size="size-6" />
          </div>
          <h3>Tarifs associatifs</h3>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Association loi 1901 à but non lucratif : coûts calculés au plus juste. Facturation carburant inclus, à la minute.
        </p>
      </Card>
      <Card as="li" size="lg" class="bg-page">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex size-10 items-center justify-center rounded-lg bg-light-frost text-brand" aria-hidden="true">
            <Icon name="shield" size="size-6" />
          </div>
          <h3>Sécurité & culture juste</h3>
        </div>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Signalement libre, retours d'expérience et accompagnement bienveillant : la sécurité est un état d'esprit partagé par tous.
        </p>
      </Card>
    </ul>
  </Section>

  <section class="bg-page py-14 lg:py-20" aria-labelledby="visit-heading">
    <div class="container">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div class="order-2 lg:order-1">
          <p class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-label text-brand">
            <Icon name="map-pin" size="size-4" />
            Aéroport de Lyon Bron · LFLY
          </p>
          <h2 id="visit-heading" class="mb-4">Venez nous rencontrer</h2>
          <p class="mb-8 max-w-prose leading-relaxed text-muted">
            Poussez la porte du club, sans aucun engagement. Curieux d'un premier vol ou pilote en quête d'une nouvelle base, nos membres vous accueillent volontiers autour d'un café, hangar et pistes en toile de fond.
          </p>

          {visitItems.length > 0 && (
            <ul class="mb-8 flex flex-col gap-4">
              {visitItems.map((item) => (
                <li class="flex items-start gap-3">
                  <span
                    class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-light-frost text-brand"
                    aria-hidden="true"
                  >
                    <Icon name={item.icon} size="size-4" />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs font-semibold uppercase tracking-label text-muted">{item.label}</span>
                    {item.href ? (
                      <a href={item.href} class="text-sm font-medium text-ink no-underline transition-colors hover:text-brand">
                        {item.value}
                      </a>
                    ) : (
                      <span class="text-sm font-medium text-ink">{item.value}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          )}

          <div class="flex flex-wrap gap-3">
            <ButtonLink href="/contact" variant="blue">Voir les infos pratiques</ButtonLink>
            {phoneHref && (
              <ButtonLink href={phoneHref} variant="outline-dark" class="md:hidden">
                <Icon name="phone" size="size-4" />
                Appeler le club
              </ButtonLink>
            )}
          </div>
        </div>

        {galleryImages.length > 0 && (
          <div class="order-1 lg:order-2">
            <Carousel images={galleryImages} class="shadow-[0_24px_60px_-15px_rgba(4,32,90,0.25)] ring-1 ring-line" />
          </div>
        )}
      </div>
    </div>
  </section>
</MainLayout>

