---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ButtonLink from "../components/ButtonLink.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBanner from "../components/CtaBanner.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { toTelHref } from "../lib/phone";


const contactEntries = await getCollection("contactSettings");
const contact = contactEntries[0]?.data;

const offers = (await getCollection("offers")).sort((a, b) => a.data.order - b.data.order);

function getAnchor(id: string) {
  return id.split("/")[0];
}

const faqItems = (await getCollection("faq"))
  .filter((f) => f.data.page === "discovery-flights")
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ q: f.data.question, a: f.data.answer }));

const pageJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Vol découverte en avion léger à Lyon Bron",
    description:
      "Vol d'initiation au pilotage depuis l'aéroport de Lyon Bron avec un instructeur qualifié. Dès 170 €, aucune expérience requise.",
    provider: {
      "@type": "SportsClub",
      name: "Aéroclub du Grand Lyon",
      url: "https://acgl.fr",
    },
    areaServed: "Lyon, Auvergne-Rhône-Alpes",
    offers: {
      "@type": "Offer",
      priceCurrency: "EUR",
      price: "170",
      eligibleRegion: "FR",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---

<MainLayout
  title="Vol découverte, initiation et baptême de l'air à Lyon Bron | ACGL"
  description="Vol découverte en avion léger à Lyon - à partir de 170 €. Prenez les commandes avec un instructeur au-dessus de Lyon. Vol d'initiation, forfait 3 vols et coavionnage Wingly disponibles."
>
  {pageJsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} slot="head" />
  ))}

  <PageHero
    title="Vols découverte & initiation au pilotage"
    description="Votre première fois dans un cockpit, ou un cadeau inoubliable au départ de l'aéroport de Bron."
  >
  </PageHero>

  {offers.map((offer, idx) => {
    const anchor = getAnchor(offer.id);
    const isEven = idx % 2 === 0;
    const iconName = offer.data.icon;
    return (
      <Section
        id={anchor}
        labelledby={`offer-${anchor}`}
        bg={isEven ? "surface" : "page"}
      >
        <div class:list={["grid items-center gap-8 md:gap-10 lg:gap-14", offer.data.photo && "md:grid-cols-2"]}>
          {offer.data.photo && (
            <div>
              <Image
                src={offer.data.photo}
                alt={offer.data.title}
                width={800}
                class="w-full rounded-2xl object-cover aspect-[4/3] max-h-[55svh] md:max-h-none shadow-acgl"
              />
            </div>
          )}

          <div class:list={[!offer.data.photo && "max-w-2xl"]}>
            <div class="mb-4 flex items-center gap-3">
              <div class="flex size-12 shrink-0 items-center justify-center rounded-lg bg-light-frost text-brand" aria-hidden="true">
                <Icon name={iconName} size="size-6" />
              </div>
              <h2 id={`offer-${anchor}`} class="mb-0">
                {offer.data.title}
              </h2>
            </div>
            <p class="text-base leading-relaxed text-muted">{offer.data.description}</p>

            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-6">
              {offer.data.duration && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-label text-muted">Durée</dt>
                  <dd class="mt-1 text-sm font-medium text-ink">{offer.data.duration}</dd>
                </div>
              )}
              {offer.data.price && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-label text-muted">Tarif</dt>
                  <dd class="mt-1 text-sm font-bold text-brand">{offer.data.price}</dd>
                </div>
              )}
              {offer.data.capacity && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-label text-muted">Places</dt>
                  <dd class="mt-1 text-sm font-medium text-ink">{offer.data.capacity}</dd>
                </div>
              )}
              <div>
                <dt class="text-xs font-semibold uppercase tracking-label text-muted">Départ</dt>
                <dd class="mt-1 text-sm font-medium text-ink">Lyon Bron (LFLY)</dd>
              </div>
            </dl>

            {offer.data.notes && (
              <p class="mt-6 text-sm leading-relaxed text-muted">{offer.data.notes}</p>
            )}

            <div class="mt-8 flex flex-wrap gap-3">
              <ButtonLink href={`/contact?subject=${encodeURIComponent("Réservation " + offer.data.title)}#formulaire`} variant="blue">Réserver</ButtonLink>
              {contact?.phone && (
                <ButtonLink href={`tel:${toTelHref(contact.phone)}`} variant="outline-dark" class="md:hidden">
                  <Icon name="phone" size="size-4" />
                  Appeler le club
                </ButtonLink>
              )}
            </div>
          </div>
        </div>
      </Section>
    );
  })}

  <Section labelledby="faq-discovery-heading" bg="page">
    <h2 id="faq-discovery-heading" class="mb-8">Questions fréquentes</h2>
    <FaqAccordion items={faqItems} />
  </Section>

  <CtaBanner
    title="Prêt à décoller ?"
    description="Contactez-nous par email ou venez nous rencontrer lors de notre permanence pour réserver votre vol."
    primaryHref="/contact"
    primaryLabel="Réserver maintenant"
    secondaryHref="/tarifs"
    secondaryLabel="Voir les tarifs"
  >
  </CtaBanner>
</MainLayout>
